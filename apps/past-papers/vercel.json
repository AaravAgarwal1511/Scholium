{
  "ignoreCommand": "npx turbo-ignore",
  "trailingSlash": false,
  "functions": {
    "api/*.js": {
      "includeFiles": "server/pdfjs-standard-fonts/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://ritfwedtjiotfxdmuief.supabase.co https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(papers/.*|sitemap.xml|llms.txt|robots.txt|og.png|logo.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    { "source": "/generate", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/papers/:subject/topics/:slug", "destination": "/papers/:subject/topics/:slug/index.html" },
    { "source": "/papers/:subject/:component", "destination": "/papers/:subject/:component/index.html" },
    { "source": "/papers/:subject", "destination": "/papers/:subject/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/signin", "destination": "/index.html" },
    { "source": "/signup", "destination": "/index.html" },
    { "source": "/auth/reset-password", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" }
  ]
}
