{
  "name": "past-papers",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node --env-file=.env --env-file-if-exists=.env.development server.js\"",
    "dev:client": "vite",
    "dev:server": "node --env-file=.env --env-file-if-exists=.env.development server.js",
    "build": "node scripts/build-subject-pages.js && vite build && node scripts/prerender-legal.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "check-types": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "upload:questions": "node --env-file=.env scripts/upload-questions.js",
    "index:papers": "node --env-file=.env scripts/build-paper-index.js",
    "seo:catalog": "node --env-file=.env scripts/build-seo-catalog.js",
    "seo:og-image": "node scripts/build-og-image.mjs",
    "lighthouse": "node scripts/build-subject-pages.js && vite build --mode test && node scripts/prerender-legal.mjs && lhci autorun --config=lighthouserc.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1083.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@repo/analytics": "workspace:*",
    "@repo/hooks": "workspace:*",
    "@repo/session": "workspace:*",
    "@repo/ui": "workspace:*",
    "@supabase/supabase-js": "^2.86.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "lucide-react": "^0.462.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "pdfkit": "^0.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.1",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  }
}
