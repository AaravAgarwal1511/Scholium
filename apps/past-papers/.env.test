# Committed on purpose — these are NOT credentials.
#
# Vite loads .env.test whenever the mode is "test", which is vitest's default.
# src/integrations/supabase/client.ts calls createClient() at module scope, so
# merely importing a page or a context throws "supabaseUrl is required" when
# these are unset. That made every story touching Supabase fail on any machine
# without a local .env — including CI, which will never have one.
#
# The URL points at nothing and the key is not a JWT. Any test that needs real
# behaviour must stub the client (see src/__mocks__/supabase-client.ts); nothing
# here should ever reach a server.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_PUBLISHABLE_KEY=test-anon-key-not-a-real-credential
VITE_SUPABASE_PROJECT_ID=test-project

# Pinned empty on purpose. papers.ts derives USE_R2 from this, so leaving it to
# fall through to a developer's real .env would make the test suite take the R2
# code path on their machine and the Supabase-storage path in CI.
VITE_R2_PUBLIC_URL=
